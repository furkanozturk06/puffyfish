{
  "name": "puffyfish",
  "version": "1.0.0",
  "private": true,
  "description": "Puffy Fish (Şiş Balık) - pixel-art arcade game for Android and iOS",
  "scripts": {
    "sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate --iconBackgroundColor #1f86b5 --iconBackgroundColorDark #0d426f --splashBackgroundColor #1f86b5 --splashBackgroundColorDark #061a31"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
